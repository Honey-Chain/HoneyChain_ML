# Service Port (Default: 5001)
PORT=5001

# Host binding (0.0.0.0 for containerized/cloud deployments)
HOST=0.0.0.0

# Optional Shared Secret API Key for Express <-> ML authentication
# If omitted or empty, requests are accepted without authentication (recommended for local dev)
# In production, configure this and pass matching ML_API_KEY in Express backend
ML_API_KEY=
